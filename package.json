{
  "name": "ref-studio",
  "version": "1.0.0",
  "description": "",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.mjs",
    "client": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "electron": "npm run build && esbuild server/index.mjs --bundle --platform=node --format=cjs --outfile=server/bundle.cjs && electron .",
    "build:desktop": "npm run build && esbuild server/index.mjs --bundle --platform=node --format=cjs --outfile=server/bundle.cjs && electron-builder --win portable",
    "build:exe": "npm run build && esbuild server/index.mjs --bundle --platform=node --format=cjs --outfile=server/bundle.cjs && pkg package.json --targets node18-win-x64 --output dist-exe/RefStudio.exe"
  },
  "build": {
    "appId": "com.refstudio.app",
    "productName": "RefStudio",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "server/bundle.cjs"
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    }
  },
  "bin": "server/bundle.cjs",
  "pkg": {
    "assets": [
      "dist/**/*"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "gifuct-js": "^2.1.2",
    "jszip": "^3.10.2",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^8.2.2",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.2",
    "pkg": "^5.8.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
